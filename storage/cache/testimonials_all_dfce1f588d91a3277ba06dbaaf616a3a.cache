a:3:{s:4:"data";a:2:{i:0;a:5:{s:2:"id";i:2;s:4:"name";s:14:"Hilal Muhammad";s:4:"role";s:33:"Alumni 2021 — Software Engineer";s:5:"quote";s:118:"Tempat terbaik belajar kepemimpinan sekaligus teknis. Bekal sertifikasi dan pengalaman organisasi membuka karier saya.";s:10:"created_at";s:19:"2026-09-19 07:04:03";}i:1;a:5:{s:2:"id";i:1;s:4:"name";s:11:"Andi Taufik";s:4:"role";s:33:"Alumni 2020 — Android Developer";s:5:"quote";s:122:"Organisasi ini mengajarkan saya berorientasi pada karya. Ilmu dan jaringan yang saya dapat masih saya rasakan hingga kini.";s:10:"created_at";s:19:"2026-09-19 07:04:03";}}s:7:"expires";i:1789881550;s:7:"created";i:1789881250;}